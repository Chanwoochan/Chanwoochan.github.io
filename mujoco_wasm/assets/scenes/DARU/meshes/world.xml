<mujoco model="DARU_table_world">
  <compiler angle="radian" meshdir="" texturedir=""/>

  <default>
    <geom friction="1.0 0.5 0.01"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
            rgb1="0.2 0.2 0.2" rgb2="0.3 0.3 0.3" />
    <material name="floor_mat" texture="grid" texrepeat="200 200" specular="0.2" shininess="0.5" />
  </asset>

  <include file="DARU_stand.xml"/>

  <visual>
    <headlight ambient="0.7 0.7 0.7" diffuse="0.9 0.9 0.9" specular="0.4 0.4 0.4"/>
    <map znear="0.001" zfar="10"/>
  </visual>

  <worldbody>
    <light pos="0.5 0 3" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="100 100 0.1" material="floor_mat" />

  </worldbody>
</mujoco>
